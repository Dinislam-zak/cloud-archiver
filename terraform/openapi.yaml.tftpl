openapi: 3.0.0
info:
  title: ${prefix}-archiver
  version: "1.0"

x-yc-apigateway:
  service_account_id: ${gateway_sa_id}

paths:
  /tasks:
    post:
      summary: Put an archiving task on the queue
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [name, url]
              properties:
                name:
                  type: string
                  minLength: 1
                url:
                  type: string
                  pattern: "^https?://.+"
      x-yc-apigateway-validator:
        validateRequestBody: true
        validationErrorHandler:
          statusCode: 400
          x-yc-apigateway-integration:
            type: dummy
            http_code: 200
            content:
              application/json: '{"message":"invalid task"}'
      x-yc-apigateway-integration:
        type: cloud_ymq
        action: SendMessage
        queue_url: ${queue_url}
        folder_id: ${folder_id}
      responses:
        "202":
          description: Task accepted
        "400":
          description: Invalid task

  /archives:
    get:
      summary: List archives
      x-yc-apigateway-integration:
        type: cloud_ydb
        action: Scan
        database: ${database_path}
        table_name: archives
      responses:
        "200":
          description: Array of archive records
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Archive"

  /archives/{key}:
    get:
      summary: Archive info
      parameters:
        - name: key
          in: path
          required: true
          schema:
            type: string
      x-yc-apigateway-integration:
        type: cloud_ydb
        action: GetItem
        database: ${database_path}
        table_name: archives
        key: '{"key": "{key}"}'
      responses:
        "200":
          description: Record found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Archive"
        "404":
          description: Record not found

  /download/{key}:
    get:
      summary: Download ZIP
      parameters:
        - name: key
          in: path
          required: true
          schema:
            type: string
      x-yc-apigateway-integration:
        type: object_storage
        bucket: ${bucket_name}
        object: "{key}"
      responses:
        "200":
          description: ZIP archive
          content:
            application/zip:
              schema:
                type: string
                format: binary
        "404":
          description: Object not found

components:
  schemas:
    Archive:
      type: object
      properties:
        name:
          type: string
        url:
          type: string
        key:
          type: string
